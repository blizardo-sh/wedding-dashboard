{
  "name": "wedding-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && node scripts/check-build.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "test:security": "firebase emulators:exec --only firestore --project demo-wedding-dashboard \"node --test tests/security/*.test.mjs\"",
    "data:export": "node scripts/export-cloud.mjs",
    "check:public": "node scripts/check-public-source.mjs",
    "format": "prettier --write src scripts tests vite.config.mjs index.html *.json *.md",
    "test:data": "python3 -m unittest discover -s tests/data -v"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.1.2",
    "firebase": "13.0.0",
    "lucide-react": "1.59.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vite": "8.3.4"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "firebase-tools": "15.34.0",
    "prettier": "3.9.10"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@11.25.0"
}
